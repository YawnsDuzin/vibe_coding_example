# === 바이브코딩 보일러플레이트 환경 설정 ===
# 이 파일을 복사하여 .env 파일을 만드세요: cp .env.example .env
# .env 파일은 Git에 올라가지 않으므로 안전합니다.

# --- 앱 기본 설정 ---
APP_NAME=바이브코딩 앱
APP_VERSION=1.0.0

# --- 데이터베이스 설정 ---
# DB_TYPE: sqlite 또는 postgresql 중 선택
DB_TYPE=sqlite

# SQLite 설정 (DB_TYPE=sqlite 일 때 사용)
SQLITE_DB_PATH=data/app.db

# PostgreSQL 설정 (DB_TYPE=postgresql 일 때 사용)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=vibe_coding_db
PG_USER=your_username
PG_PASSWORD=your_password

# --- 로깅 설정 ---
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL 중 선택
LOG_LEVEL=INFO
LOG_DIR=logs
