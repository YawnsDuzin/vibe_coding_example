/* === 라이트 테마 스타일시트 (Light Theme) ===
   이 파일은 앱의 모든 위젯의 외관을 결정합니다.
   CSS와 비슷한 문법으로, 위젯 종류나 이름(objectName)으로 스타일을 지정합니다. */

/* --- 전체 배경 --- */
QWidget {
    background-color: #f5f5f5;
    color: #333333;
    font-family: "맑은 고딕", "Malgun Gothic", sans-serif;
    font-size: 13px;
}

/* --- 메인 윈도우 --- */
QMainWindow {
    background-color: #f5f5f5;
}

/* --- 네비게이션 바 --- */
#navbar {
    background-color: #2c3e50;
    border-right: 1px solid #1a252f;
}

#navButton {
    background-color: transparent;
    color: #bdc3c7;
    border: none;
    border-radius: 6px;
    padding: 10px 14px;
    text-align: left;
    font-size: 13px;
}

#navButton:hover {
    background-color: #34495e;
    color: #ecf0f1;
}

#navButton:checked {
    background-color: #3498db;
    color: #ffffff;
}

#navToggle {
    background-color: transparent;
    color: #bdc3c7;
    border: none;
    border-radius: 4px;
    font-size: 14px;
}

#navToggle:hover {
    background-color: #34495e;
    color: #ecf0f1;
}

/* --- 헤더 --- */
#header {
    background-color: #ffffff;
    border-bottom: 1px solid #e0e0e0;
}

#userLabel {
    color: #2c3e50;
    font-weight: bold;
    font-size: 13px;
}

#roleLabel {
    color: #7f8c8d;
    font-size: 12px;
    margin-left: 4px;
}

#logoutButton {
    background-color: transparent;
    color: #e74c3c;
    border: 1px solid #e74c3c;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}

#logoutButton:hover {
    background-color: #e74c3c;
    color: #ffffff;
}

/* --- 앱 타이틀 (로그인 화면) --- */
#appTitle {
    color: #2c3e50;
    background-color: transparent;
}

/* --- 버튼: 기본 (Primary) --- */
#primaryButton {
    background-color: #3498db;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
}

#primaryButton:hover {
    background-color: #2980b9;
}

#primaryButton:pressed {
    background-color: #2471a3;
}

/* --- 버튼: 링크 스타일 --- */
#linkButton {
    background-color: transparent;
    color: #3498db;
    border: none;
    font-size: 12px;
}

#linkButton:hover {
    color: #2980b9;
    text-decoration: underline;
}

/* --- 입력 필드 --- */
QLineEdit {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #bdc3c7;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit:focus {
    border-color: #3498db;
}

QLineEdit:disabled {
    background-color: #ecf0f1;
    color: #95a5a6;
}

/* --- 라벨 --- */
QLabel {
    background-color: transparent;
    color: #2c3e50;
    font-size: 13px;
}

/* --- 콤보박스 (드롭다운) --- */
QComboBox {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #bdc3c7;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

QComboBox:hover {
    border-color: #3498db;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

/* --- 체크박스 --- */
QCheckBox {
    color: #2c3e50;
    spacing: 8px;
    font-size: 13px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #bdc3c7;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #3498db;
    border-color: #3498db;
}

/* --- 그룹박스 --- */
QGroupBox {
    border: 1px solid #bdc3c7;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    color: #2c3e50;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* --- 테이블 --- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f9f9f9;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    gridline-color: #e0e0e0;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget::item:selected {
    background-color: #3498db;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #ecf0f1;
    color: #2c3e50;
    border: none;
    border-bottom: 2px solid #bdc3c7;
    padding: 8px;
    font-weight: bold;
}

/* --- 스크롤바 --- */
QScrollBar:vertical {
    background-color: #f5f5f5;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #bdc3c7;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- 상태 표시줄 --- */
QStatusBar {
    background-color: #ecf0f1;
    color: #7f8c8d;
    border-top: 1px solid #bdc3c7;
    font-size: 11px;
}

/* --- 구분선 --- */
QFrame[frameShape="4"] {
    color: #e0e0e0;
}

/* --- 메시지 박스 --- */
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #333333;
    font-size: 13px;
}
